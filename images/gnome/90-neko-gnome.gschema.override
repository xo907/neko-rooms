# Defaults for a desktop many people watch at once.

# never lock or blank the shared screen
[org.gnome.desktop.screensaver]
lock-enabled=false
idle-activation-enabled=false

[org.gnome.desktop.session]
idle-delay=uint32 0

[org.gnome.desktop.lockdown]
disable-lock-screen=true

[org.gnome.settings-daemon.plugins.power]
sleep-inactive-ac-type='nothing'
idle-dim=false

# dark like the rooms around it; animations off, they stutter when drawn in
# software and streamed
[org.gnome.desktop.interface]
color-scheme='prefer-dark'
enable-animations=false

# the browser first in the dash, and no welcome tour
[org.gnome.shell]
favorite-apps=['firefox-esr.desktop', 'org.gnome.Nautilus.desktop', 'org.gnome.Terminal.desktop']
welcome-dialog-last-shown-version='999'

# fractional scaling draws to a framebuffer of its own size, which goes out
# of step with the screen when neko changes the resolution
[org.gnome.mutter]
experimental-features=[]
