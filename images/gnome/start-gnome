#!/bin/sh
# GNOME Shell on neko's X server: no display manager and no systemd, so the
# session gets a bus of its own, the settings daemons GTK apps read their
# theme from, and then the shell itself.

export XDG_SESSION_TYPE=x11
export XDG_CURRENT_DESKTOP=GNOME
export XDG_SESSION_DESKTOP=gnome
export DESKTOP_SESSION=gnome
export GNOME_SHELL_SESSION_MODE=user
export XDG_RUNTIME_DIR="/tmp/runtime-$USER"

# rooms have no GPU, mesa draws in software
export LIBGL_ALWAYS_SOFTWARE=1
export GALLIUM_DRIVER=llvmpipe

mkdir -p "$XDG_RUNTIME_DIR"
chmod 0700 "$XDG_RUNTIME_DIR"

exec dbus-run-session -- sh -c '
  for d in xsettings a11y-settings keyboard media-keys sound; do
    if [ -x "/usr/libexec/gsd-$d" ]; then "/usr/libexec/gsd-$d" & fi
  done

  # neko changes the resolution under the shell, and when it is drawn in
  # software the shell keeps drawing at the old size. So it restarts when
  # the size changes; windows belong to X and stay open meanwhile.
  (
    last=""
    while sleep 1; do
      size=$(xrandr --current 2>/dev/null | sed -n "s/.*current \([0-9]*\) x \([0-9]*\).*/\1x\2/p")
      [ -n "$size" ] || continue
      if [ -n "$last" ] && [ "$size" != "$last" ]; then
        sleep 1
        pkill -x gnome-shell
      fi
      last="$size"
    done
  ) &

  while :; do
    gnome-shell --x11 --replace
    sleep 1
  done
'
