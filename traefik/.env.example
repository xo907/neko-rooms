NEKO_ROOMS_EPR=59000-59049
NEKO_ROOMS_NAT1TO1=192.168.1.20

NEKO_ROOMS_TRAEFIK_DOMAIN=neko-rooms.server.lan
NEKO_ROOMS_TRAEFIK_ENTRYPOINT=websecure
NEKO_ROOMS_TRAEFIK_NETWORK=neko-rooms-traefik
NEKO_ROOMS_TRAEFIK_CERTRESOLVER=lets-encrypt

TZ=Europe/Vienna

# trust X-Forwarded-* headers from traefik (client IPs, secure cookies)
NEKO_ROOMS_PROXY=true

# first admin account, created on first start only
# leave the password empty to get a one-time setup token in the logs instead
NEKO_ROOMS_ADMIN_USERNAME=admin
NEKO_ROOMS_ADMIN_PASSWORD=
